# AI AINAK Environment Configuration
# Copy this file to .env and adjust variables as appropriate for your environment.

# Execution device: "cpu" or "cuda" / "cuda:0"
AINAK_DEVICE=cpu

# Log level: DEBUG, INFO, WARNING, ERROR
AINAK_LOG_LEVEL=INFO

# Paths (defaults are relative to project root)
AINAK_ARTIFACTS_DIR=artifacts
AINAK_DATASETS_DIR=datasets
AINAK_REPORTS_DIR=reports

# Optional Hugging Face / Kaggle tokens (only needed for remote runs)
# HF_TOKEN=
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# Speech synthesis configuration
AINAK_SPEECH_BACKEND=auto  # "auto", "pyttsx3", "system_speech", "text_only"
AINAK_SPEECH_RATE=180
AINAK_SPEECH_VOLUME=1.0
